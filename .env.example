NODE_ENV=development
PORT=4000

# Neon pooled connection string (use ?sslmode=require for Neon/hosted Postgres)
DATABASE_URL=postgresql://user:password@localhost:5432/family_tracker?schema=public

# Auth secrets — generate strong random values in production
JWT_ACCESS_SECRET=replace-with-a-long-random-string
JWT_REFRESH_SECRET=replace-with-another-long-random-string
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=30d

# Comma-separated list of allowed frontend origins
CORS_ORIGIN=http://localhost:5173

LOG_LEVEL=info

# Web Push (optional). Generate with: node -e "console.log(require('web-push').generateVAPIDKeys())"
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@family-tracker.local

# Secret required in the x-cron-secret header to trigger POST /api/push/run
CRON_SECRET=
